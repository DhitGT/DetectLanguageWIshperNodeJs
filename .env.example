# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
API_KEY=CHANGE_ME_generate_random_secret_at_least_32_characters
HOST=127.0.0.1
PORT=8000
WHISPER_MODEL=onnx-community/whisper-base
MODEL_CACHE=./models
CPU_THREADS=4
MAX_UPLOAD_MB=8
MAX_AUDIO_SECONDS=30
MIN_SPEECH_SECONDS=0.6
MIN_CONFIDENCE=0.7
MAX_IN_FLIGHT=2
CORS_ORIGINS=
# Optional: path FFmpeg sistem. Kosong = binary dari ffmpeg-static.
FFMPEG_PATH=
